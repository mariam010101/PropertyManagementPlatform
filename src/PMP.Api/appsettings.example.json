{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=pmp.db;Foreign Keys=True"
  },
  "Jwt": {
    "Issuer": "PMP",
    "Audience": "PMP",
    "Key": "YOUR_JWT_SECRET_KEY",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 14
  }
}
